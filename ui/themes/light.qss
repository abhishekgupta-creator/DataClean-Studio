/* ==========================================
   DataClean Studio - Premium Light Theme
   ========================================== */

/* Main application */
QMainWindow,
#centralWidget,
#workspace,
#pageStack {
    background-color: #F7F9FF;
}

/* Sidebar */
#sidebar {
    background-color: #F0F4FF;
    border-right: 1px solid #DCE6F8;
}

/* Logo */
#logo {
    color: #17243A;
    font-size: 22px;
    font-weight: bold;
}

#tagline {
    color: #71809A;
    font-size: 11px;
}

#sidebarSection {
    color: #8292AA;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* Navigation */
QPushButton#navButton {
    background-color: transparent;
    color: #35445D;
    text-align: left;
    padding: 11px 13px;
    border: none;
    border-radius: 12px;
    font-size: 13px;
}

QPushButton#navButton:hover {
    background-color: #E5EDFF;
    color: #1264D8;
}

QPushButton#navButton[active="true"] {
    background-color: #DCE8FF;
    color: #1264D8;
    font-weight: bold;
}

/* Topbar */
#topbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5EBF5;
}

#topbarTitle {
    color: #17243A;
    font-size: 19px;
    font-weight: bold;
}

#versionLabel {
    color: #71809A;
    font-size: 11px;
}

/* General page typography */
#pageTitle {
    color: #17243A;
    font-size: 29px;
    font-weight: bold;
}

#pageSubtitle {
    color: #71809A;
    font-size: 13px;
}

/* Hero section */
#heroCard {
    background-color: #EEF4FF;
    border: 1px solid #E0E9FF;
    border-radius: 22px;
}

#welcomeBadge {
    color: #1264D8;
    background-color: #DCE9FF;
    border: 1px solid #C8DCFF;
    border-radius: 14px;
    padding: 8px 13px;
    font-size: 14px;
    font-weight: bold;
}

#heroTitle {
    color: #1264D8;
    font-size: 36px;
    font-weight: bold;
}

#heroSubtitle {
    color: #53627A;
    font-size: 21px;
    font-weight: bold;
}

#heroDescription {
    color: #66748A;
    font-size: 15px;
}

/* Hero import button */
QPushButton#heroImportButton {
    background-color: #1264E8;
    color: #FFFFFF;
    border: none;
    border-radius: 13px;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#heroImportButton:hover {
    background-color: #0754CC;
}

QPushButton#heroImportButton:pressed {
    background-color: #0645A8;
}

/* Feature section */
#featureSectionTitle {
    color: #17243A;
    font-size: 21px;
    font-weight: bold;
}

/* Feature cards */
#featureCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E9F5;
    border-radius: 17px;
}

#featureCard:hover {
    border: 1px solid #A9C9FF;
    background-color: #FBFCFF;
}

#featureIcon {
    background-color: #E8F0FF;
    color: #1264E8;
    border-radius: 15px;
    font-size: 30px;
    font-weight: bold;
}

#featureCard[featureType="cleanCard"] #featureIcon {
    background-color: #F0EAFE;
    color: #7145D9;
}

#featureCard[featureType="transformCard"] #featureIcon {
    background-color: #F0EAFE;
    color: #7145D9;
}

#featureHeading {
    color: #17243A;
    font-size: 16px;
    font-weight: bold;
}

#featureDescription {
    color: #68758B;
    font-size: 12px;
}

/* Existing welcome components */
#welcomeCard,
#stepCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E9F5;
    border-radius: 13px;
}

#welcomeTitle {
    color: #17243A;
    font-size: 21px;
    font-weight: bold;
}

#welcomeDescription,
#stepDescription {
    color: #71809A;
    font-size: 13px;
}

#sectionTitle {
    color: #17243A;
    font-size: 19px;
    font-weight: bold;
}

#stepNumber {
    color: #1264D8;
    font-size: 20px;
    font-weight: bold;
}

#stepHeading {
    color: #17243A;
    font-size: 14px;
    font-weight: bold;
}

/* Existing buttons */
QPushButton#primaryButton {
    background-color: #1264E8;
    color: white;
    border: none;
    border-radius: 9px;
    padding: 12px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #0754CC;
}

/* Placeholder pages */
#placeholderTitle {
    color: #17243A;
    font-size: 25px;
    font-weight: bold;
}

#placeholderDescription {
    color: #71809A;
    font-size: 14px;
}

/* Modern Sidebar Branding */
#sidebar {
    background-color: #F0F4FF;
    border-right: 1px solid #DCE6F8;
}

#logoIcon {
    background-color: #DCE8FF;
    color: #1264D8;
    border-radius: 12px;
    font-size: 23px;
    font-weight: bold;
}

#logo {
    color: #17243A;
    font-size: 18px;
    font-weight: bold;
}

#tagline {
    color: #71809A;
    font-size: 10px;
}

#sidebarSection {
    color: #8292AA;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #35445D;
    text-align: left;
    padding: 10px 12px;
    border: none;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #E5EDFF;
    color: #1264D8;
}

QPushButton#navButton[active="true"] {
    background-color: #DCE8FF;
    color: #1264D8;
    font-weight: bold;
}

/* Sidebar Footer */
QLabel#sidebarFooter {
    color: #91A0B7;
    font-size: 11px;
    font-weight: 600;
    padding: 14px 4px 4px 4px;
    margin-top: 8px;
    border-top: 1px solid #DCE6F8;
}